{
  "name": "@hyperdrift-io/clear-mermaid-mcp",
  "version": "0.1.0",
  "description": "Explore Mermaid flowcharts from your AI assistant with Clear Mermaid's local browser reader.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "clear-mermaid-mcp": "bin/clear-mermaid.mjs"
  },
  "files": [
    "bin",
    "lib",
    "web",
    "renderer/dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "renderer/manifest.json"
  ],
  "scripts": {
    "build": "cd renderer && vite build && node ../scripts/manifest.mjs",
    "test": "node --test test/server.test.mjs",
    "test:browser": "node test/browser.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "beautiful-mermaid": "1.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "elkjs": "0.12.0",
    "mermaid": "12.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperdrift-io/clear-mermaid.git"
  },
  "homepage": "https://github.com/hyperdrift-io/clear-mermaid#readme"
}
