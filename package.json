{
  "name": "@hyperdrift-io/clear-mermaid-mcp",
  "version": "0.2.0",
  "description": "Interactive Mermaid flowcharts in MCP Apps and local browser readers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "clear-mermaid-mcp": "bin/clear-mermaid.mjs"
  },
  "files": [
    "bin",
    "lib",
    "web",
    "widget/dist/THIRD_PARTY_LICENSES.md",
    "renderer/dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "renderer/manifest.json"
  ],
  "scripts": {
    "build": "cd renderer && vite build && node ../scripts/manifest.mjs",
    "test": "node --test test/server.test.mjs",
    "test:browser": "node test/browser.mjs",
    "prepack": "node scripts/check-package.mjs",
    "build:widget": "cd widget && vite build && node ../scripts/widget.mjs",
    "test:hosted": "node --test test/hosted.test.mjs",
    "test:widget": "node test/widget.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "beautiful-mermaid": "1.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "elkjs": "0.12.0",
    "mermaid": "12.2.0",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperdrift-io/clear-mermaid.git"
  },
  "homepage": "https://github.com/hyperdrift-io/clear-mermaid#readme",
  "exports": {
    "./hosted": {
      "types": "./lib/hosted.d.ts",
      "import": "./lib/hosted.mjs"
    }
  }
}
